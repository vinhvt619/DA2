PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/RabbitCV
MONGO_DB_NAME=RabbitCV
JWT_SECRET=replace-with-your-local-secret
CLIENT_URL=http://localhost:4000
VITE_SOCKET_URL=
REALTIME_SERVER_URL=
REALTIME_SHARED_SECRET=replace-with-a-random-realtime-secret
REALTIME_RELAY_TIMEOUT_MS=5000
AI_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_DAILY_LIMIT=100
AI_REQUEST_TIMEOUT_MS=20000
CRON_SECRET=replace-with-a-random-cron-secret
NODE_ENV=development
# Direct password recovery is for demos only. Production disables it by default.
# Set this explicitly only for a demo deployment; never for real accounts.
# ALLOW_DEMO_PASSWORD_RESET=true
